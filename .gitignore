# Python cache and compiled files
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*~

# OS files
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Testing
.pytest_cache/
.coverage

# Backup files
*.bak
*.tmp
*.log

# Screenshots (personal use, not tracked)
screenshots/*
!screenshots/.gitkeep

# Project data directories (upstream)
Python_MATLAB_Codes/saved_models/
Python_MATLAB_Codes/your_augmented_datasets/

# Training data and models - ignore files but preserve directory structure
Python_MATLAB_Codes/train_inference_python/augmented_datasets/**/*
!Python_MATLAB_Codes/train_inference_python/augmented_datasets/**/.gitkeep
Python_MATLAB_Codes/train_inference_python/trained_models/**/*
!Python_MATLAB_Codes/train_inference_python/trained_models/**/.gitkeep

# PSF outputs - ignore generated files but keep structure
psf/output/**/*.tif
psf/output/**/*.tiff
!psf/output/**/.gitkeep
!psf/output/other/*.tif
!psf/output/other/*.tiff
!psf/output/other/note.txt

psf/test/**/*.tif
psf/test/**/*.tiff
!psf/test/**/.gitkeep

# Raw_Data with fine-grained control for FromGary
Raw_Data/*
!Raw_Data/FromGary/
!Raw_Data/FromGary/.gitkeep
Raw_Data/FromGary/input/
Raw_Data/FromGary/test_Fiji_GaussianBlur/
!Raw_Data/FromGary/sample_data/
!Raw_Data/FromGary/sample_data/.gitkeep
!Raw_Data/FromGary/sample_data/*.md
Raw_Data/FromGary/sample_data/*.tif
Raw_Data/FromGary/sample_data/*.tiff
